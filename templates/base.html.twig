<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Spots Kitesurf{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('spot_index') }}">⛵ Kitesurf</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li><a class="nav-link" href="{{ path('spot_index') }}">Liste</a></li>
                    <li><a class="nav-link" href="{{ path('spot_map') }}">Carte</a></li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li><a class="nav-link" href="{{ path('spot_new') }}">+ Spot</a></li>
                        <li><a class="nav-link" href="{{ path('spots_import') }}">Import</a></li>
                        <li><a class="nav-link" href="{{ path('spots_export') }}">Export</a></li>
                        <li><a class="nav-link" href="{{ path('app_logout') }}">Logout</a></li>
                    {% else %}
                        <li><a class="nav-link" href="{{ path('app_login') }}">Login</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        {% for msg in app.flashes('success') %}<div class="alert alert-success">{{ msg }}</div>{% endfor %}
        {% for msg in app.flashes('error') %}<div class="alert alert-danger">{{ msg }}</div>{% endfor %}
        {% block content %}{% endblock %}
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    {% block js %}{% endblock %}
</body>
</html>
